# ==========================================
# VILLA COCO - ENVIRONMENT VARIABLES TEMPLATE
# Copia este archivo a `.env.local` para desarrollo local
# ==========================================

# WordPress Headless REST API
WORDPRESS_API_URL=http://localhost:8881

# HubSpot CRM Configuration
HUBSPOT_PORTAL_ID=your_hubspot_portal_id
# ID del formulario de solicitud de villa (no es el nombre visible del formulario)
HUBSPOT_FORM_ID=your_hubspot_form_id

# AI / Chatbot (Google Gemini API / Groq API)
GEMINI_API_KEY=your_gemini_api_key


# Public Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
